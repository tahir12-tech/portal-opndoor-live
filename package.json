{
  "name": "opndoor-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "opndoor Guarantee Referral Portal \u2014 production-ready React front end. A back end replaces the src/data service layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --environment jsdom",
    "smoke": "vitest run --environment jsdom",
    "test:db": "supabase test db",
    "drift": "node scripts/schema-drift.mjs",
    "schema:final": "node scripts/schema-final-state.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.9"
  }
}
